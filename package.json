{
  "name": "lingualink-play",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "LinguaLink360 therapy games: speech, voice, oral-motor and motor practice in the browser (static ES modules, no build step).",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:voice": "node tests/e2e/voice.mjs",
    "test:words": "node tests/e2e/words.mjs",
    "test:all": "npm test && npm run test:e2e"
  }
}
